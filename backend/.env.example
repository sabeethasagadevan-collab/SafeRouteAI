# Copy this file to .env and add your own API key locally.
TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY

# Only configure an incident endpoint after confirming access and schema in your TomTom account.
TOMTOM_INCIDENT_ENDPOINT=

DATABASE_URL=sqlite:///./saferoute.db
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080
REQUEST_TIMEOUT_SECONDS=10